{
  "name": "threat-monitoring-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "merge-openapi": "npx openapi-merge-cli --config ./src/swagger/openapi.config.json",
    "codegen:api": "node ./src/codegen/codegen.js",
    "codegen": "npm run merge-openapi && npm run codegen:api"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "axios": "^1.16.0",
    "bootstrap": "^5.3.2",
    "openapi-merge-cli": "^1.3.2",
    "openapi-typescript": "^7.13.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.9.0",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.17.0",
    "swagger-typescript-api": "^13.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
